# Copy this file to dashboard/.env and fill in both values (no quotes).
# Never commit dashboard/.env; it is already in .gitignore.
AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=
# Optional, defaults to Calls
# AIRTABLE_TABLE=Calls
# Optional, how often the dashboard reloads calls, in minutes. Defaults to 60
# REFRESH_MINUTES=60
